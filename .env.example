# ── Google OAuth ─────────────────────────────────────────────────────────────
# Desktop-app OAuth 2.0 client credentials from Google Cloud Console.
# Use "Internal" app type (your own Workspace) for long-lived refresh tokens.
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Path where the encrypted OAuth token is persisted (inside the data volume).
TOKEN_PATH=/data/token.json
# Optional Fernet key for the token file; auto-generated next to it if blank.
# TOKEN_ENCRYPTION_KEY=

# Request gmail.send so mailto unsubscribes can be sent from your account.
INCLUDE_SEND_SCOPE=true

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Scanning ─────────────────────────────────────────────────────────────────
# How many days back to read from Gmail (default 365).
SCAN_SINCE_DAYS=365

# ── Unsubscribe ──────────────────────────────────────────────────────────────
# Look for an unsubscribe link in the newest message body when there's no header.
BODY_LINK_SCAN=true
# Use a headless browser (Playwright) for unsubscribe pages that need a click.
BROWSER_UNSUBSCRIBE=true
# Mail this many days after unsubscribing flags the sender as "still sending".
UNSUB_GRACE_DAYS=7

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to "true" to simulate all actions without touching Gmail.
DRY_RUN=true

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=/data/mailcull.db

# ── Server ───────────────────────────────────────────────────────────────────
APP_PORT=8420
APP_HOST=127.0.0.1
